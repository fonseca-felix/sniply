# ============================================================
#  Sniply — .env.example
#  Copie este arquivo para .env e preencha com valores reais.
#  NUNCA faça commit do .env com segredos reais.
# ============================================================

# ---- Flask ----
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=gere-uma-chave-aleatoria-forte-aqui

# ---- App ----
BASE_URL=http://localhost:5000

# ---- Firebase (opção 1: arquivo local) ----
FIREBASE_CREDENTIALS=serviceAccountKey.json

# ---- Firebase (opção 2: variáveis individuais para Vercel) ----
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_PRIVATE_KEY_ID=sua-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seu-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=000000000000000000000
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...
